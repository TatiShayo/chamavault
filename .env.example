# ==============================================================================
# ChamaVault — Environment Configuration Example (.env.example)
# ==============================================================================

# Supabase (Database, Auth, Storage, Edge Functions)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key-for-development
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-service-role-key-server-only

# AI Minutes Generator (Anthropic Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=sk-dummy-openai-key-for-development

# Email Notifications (Resend API)
RESEND_API_KEY=your_resend_api_key_here

# SMS Notifications (Africa's Talking API)
AT_API_KEY=dummy_africas_talking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=ChamaVault

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment Gateways (Stripe / M-Pesa Daraja)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
